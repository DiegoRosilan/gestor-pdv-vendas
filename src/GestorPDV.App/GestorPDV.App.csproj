<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GestorPDV.App</RootNamespace>
    <!--
      Ponto de entrada é Program.Main (não o gerado automaticamente a
      partir de App.xaml) — mesmo padrão de inicialização do
      legacy/GestorPDV.Vendas (carrega configuração, decide
      login/abertura de turno, só então mostra a janela principal).
      Por isso App.xaml entra como Page logo abaixo, não como
      ApplicationDefinition.
    -->
    <StartupObject>GestorPDV.App.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GestorPDV.Application\GestorPDV.Application.csproj" />
    <ProjectReference Include="..\GestorPDV.Domain\GestorPDV.Domain.csproj" />
    <ProjectReference Include="..\GestorPDV.Infrastructure\GestorPDV.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
