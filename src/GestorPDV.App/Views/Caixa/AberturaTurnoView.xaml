<Window x:Class="GestorPDV.App.Views.Caixa.AberturaTurnoView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GestorPDV - Abertura de Turno"
        Width="480" Height="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource PincelFundoClaro}">
    <!--
        Mesma tela do legado AberturaTurnoForm (grade de turnos + combo de
        terminal + suprimento + senha do gerente), mas sem repetir
        login/senha do operador — quem abre o turno já foi autenticado na
        LoginView (ver AberturaTurnoViewModel). Uma linha Auto por
        elemento, mesmo cuidado do fix aplicado em LoginView.xaml pra não
        estourar a altura da janela e cortar a linha dos botões.
    -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- 0: título -->
            <RowDefinition Height="16" />    <!-- 1: espaço -->
            <RowDefinition Height="Auto" />  <!-- 2: rótulo Turno(s) -->
            <RowDefinition Height="120" />   <!-- 3: grade de turnos -->
            <RowDefinition Height="16" />    <!-- 4: espaço -->
            <RowDefinition Height="Auto" />  <!-- 5: rótulo Terminal -->
            <RowDefinition Height="Auto" />  <!-- 6: combo Terminal -->
            <RowDefinition Height="16" />    <!-- 7: espaço -->
            <RowDefinition Height="Auto" />  <!-- 8: rótulo Suprimento -->
            <RowDefinition Height="Auto" />  <!-- 9: campo Suprimento -->
            <RowDefinition Height="16" />    <!-- 10: espaço -->
            <RowDefinition Height="Auto" />  <!-- 11: rótulo Senha gerente -->
            <RowDefinition Height="Auto" />  <!-- 12: campo Senha gerente -->
            <RowDefinition Height="Auto" />  <!-- 13: mensagem de erro -->
            <RowDefinition Height="*" />     <!-- 14: preenche o resto -->
            <RowDefinition Height="Auto" />  <!-- 15: botões -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Abertura de Turno" FontSize="22" FontWeight="Bold"
                   Foreground="{StaticResource PincelBarraEscura}" />

        <TextBlock Grid.Row="2" Text="Turno(s):" Margin="0,0,0,4" />
        <DataGrid Grid.Row="3" ItemsSource="{Binding Turnos}" SelectedItem="{Binding TurnoSelecionado}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow" Background="White"
                  RowBackground="White" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*" />
                <DataGridTextColumn Header="Início" Binding="{Binding HoraInicio}" Width="70" />
                <DataGridTextColumn Header="Fim" Binding="{Binding HoraFim}" Width="70" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="5" Text="Terminal (caixa):" Margin="0,0,0,4" />
        <ComboBox Grid.Row="6" ItemsSource="{Binding Terminais}" SelectedItem="{Binding TerminalSelecionado}"
                  DisplayMemberPath="Nome" Padding="6" />

        <TextBlock Grid.Row="8" Text="Fundo de caixa (suprimento):" Margin="0,0,0,4" />
        <TextBox Grid.Row="9" Text="{Binding Suprimento, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Padding="6" />

        <TextBlock Grid.Row="11" Text="Senha do gerente/supervisor:" Margin="0,0,0,4" />
        <PasswordBox Grid.Row="12" x:Name="CaixaSenhaGerente" Padding="6"
                     PasswordChanged="CaixaSenhaGerente_PasswordChanged" />

        <TextBlock Grid.Row="13" Text="{Binding MensagemErro}" Foreground="{StaticResource PincelPerigo}"
                   TextWrapping="Wrap" Margin="0,12,0,0" />

        <StackPanel Grid.Row="15" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancela (ESC)" Style="{StaticResource BotaoSecundario}"
                    Width="130" Margin="0,0,8,0" Click="Cancelar_Click" IsCancel="True" />
            <Button Content="Confirma (F12)" Style="{StaticResource BotaoPrimario}"
                    Command="{Binding ConfirmarCommand}" Width="140" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
