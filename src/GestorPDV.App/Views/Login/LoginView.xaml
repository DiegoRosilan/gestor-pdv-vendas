<Window x:Class="GestorPDV.App.Views.Login.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GestorPDV - Login"
        Width="420" Height="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource PincelFundoClaro}">
    <!--
        Uma linha Auto por elemento (sem empilhar dois controles na mesma
        linha via margem grande, como a versão anterior fazia) — evita o
        conteúdo estourar a altura da janela e cortar a linha dos botões.
    -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0: título -->
            <RowDefinition Height="24" />   <!-- 1: espaço -->
            <RowDefinition Height="Auto" /> <!-- 2: rótulo Operador -->
            <RowDefinition Height="Auto" /> <!-- 3: campo Operador -->
            <RowDefinition Height="16" />   <!-- 4: espaço -->
            <RowDefinition Height="Auto" /> <!-- 5: rótulo Senha -->
            <RowDefinition Height="Auto" /> <!-- 6: campo Senha -->
            <RowDefinition Height="Auto" /> <!-- 7: mensagem de erro -->
            <RowDefinition Height="*" />    <!-- 8: preenche o resto -->
            <RowDefinition Height="Auto" /> <!-- 9: botões -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="GestorPDV" FontSize="22" FontWeight="Bold"
                   Foreground="{StaticResource PincelBarraEscura}" />

        <TextBlock Grid.Row="2" Text="Operador:" Margin="0,0,0,4" />
        <TextBox Grid.Row="3" Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" Padding="6" />

        <TextBlock Grid.Row="5" Text="Senha:" Margin="0,0,0,4" />
        <PasswordBox Grid.Row="6" x:Name="CaixaSenha" Padding="6"
                     PasswordChanged="CaixaSenha_PasswordChanged" />

        <TextBlock Grid.Row="7" Text="{Binding MensagemErro}" Foreground="{StaticResource PincelPerigo}"
                   TextWrapping="Wrap" Margin="0,12,0,0" />

        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancela (ESC)" Style="{StaticResource BotaoSecundario}"
                    Width="130" Margin="0,0,8,0" Click="Cancelar_Click" IsCancel="True" />
            <Button Content="Confirma (F12)" Style="{StaticResource BotaoPrimario}"
                    Command="{Binding ConfirmarCommand}" Width="140" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
