<Window x:Class="GestorPDV.App.Views.Fiscal.MenuFiscalView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GestorPDV - Menu Fiscal"
        Width="600" Height="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource PincelFundoClaro}">
    <!--
        Mesma listagem do legado MenuFiscalForm (COO, data/hora, valor,
        situação das notas do movimento atual) — só mostra o que já está
        gravado, não emite nada de verdade (ver MenuFiscalViewModel).
    -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0: título -->
            <RowDefinition Height="12" />   <!-- 1: espaço -->
            <RowDefinition Height="*" />    <!-- 2: grade de notas -->
            <RowDefinition Height="Auto" /> <!-- 3: mensagem -->
            <RowDefinition Height="16" />   <!-- 4: espaço -->
            <RowDefinition Height="Auto" /> <!-- 5: botão fechar -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Notas Emitidas Neste Movimento" FontSize="18" FontWeight="Bold"
                   Foreground="{StaticResource PincelBarraEscura}" />

        <DataGrid Grid.Row="2" ItemsSource="{Binding Notas}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" Background="White"
                  RowBackground="White" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="COO" Binding="{Binding Coo}" Width="80" />
                <DataGridTextColumn Header="Data/Hora" Binding="{Binding DataHora}" Width="160" />
                <DataGridTextColumn Header="Valor" Binding="{Binding Valor}" Width="130" />
                <DataGridTextColumn Header="Situação" Binding="{Binding Situacao}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="{Binding Mensagem}" Foreground="{StaticResource PincelTextoSecundario}"
                   TextWrapping="Wrap" Margin="0,8,0,0" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Fechar (ESC)" Style="{StaticResource BotaoSecundario}"
                    Width="130" Click="Fechar_Click" IsCancel="True" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
