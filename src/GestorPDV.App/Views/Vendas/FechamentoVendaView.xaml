<Window x:Class="GestorPDV.App.Views.Vendas.FechamentoVendaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="F3 - Selecione o Desconto/Acréscimo..."
        Width="520" Height="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource PincelFundoClaro}"
        Loaded="FechamentoVendaView_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Resumo da Venda" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Total Venda" Foreground="{StaticResource PincelTextoSecundario}" />
                <TextBlock Text="{Binding TotalVenda}" FontSize="16" FontWeight="Bold" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Total Recebido" Foreground="{StaticResource PincelTextoSecundario}" />
                <TextBlock Text="{Binding TotalRecebido}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PincelSucesso}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Troco" Foreground="{StaticResource PincelTextoSecundario}" />
                <TextBlock Text="{Binding Troco}" FontSize="16" FontWeight="Bold" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" ItemsSource="{Binding FormasDisponiveis}" DisplayMemberPath="Descricao"
                          SelectedItem="{Binding FormaSelecionada}" Margin="0,0,8,0" Padding="6" />
                <TextBox Grid.Column="1" Text="{Binding ValorPagamento, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,8,0" />
                <Button Grid.Column="2" Content="Lançar" Style="{StaticResource BotaoSecundario}" Command="{Binding LancarPagamentoCommand}" />
            </Grid>

            <ListBox Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding PagamentosLancados}" DisplayMemberPath="Descricao" />
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding Mensagem}" Foreground="{StaticResource PincelPerigo}" Margin="0,8,0,0" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancela (ESC)" Style="{StaticResource BotaoSecundario}" Width="120" Margin="0,0,8,0" Click="Cancelar_Click" />
            <Button Content="Finaliza (F12)" Style="{StaticResource BotaoPrimario}" Width="120" Command="{Binding FinalizarCommand}" />
        </StackPanel>
    </Grid>
</Window>
