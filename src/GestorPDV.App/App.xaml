<Application x:Class="GestorPDV.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        ApplicationDefinition padrão, sem StartupUri — o Main() é gerado
        automaticamente pelo compilador de XAML e chama OnStartup
        (App.xaml.cs), que monta a DI, resolve a LoginView e só depois
        mostra a MainView. App.xaml aqui só carrega os dicionários de
        recurso compartilhados.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Cores.xaml" />
                <ResourceDictionary Source="Resources/Styles/Botoes.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
