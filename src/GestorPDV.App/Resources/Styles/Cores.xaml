<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Mesma paleta usada no PDV WinForms (legacy/GestorPDV.Vendas/PdvTheme.cs), pra manter a identidade visual entre as duas versões. -->
    <Color x:Key="CorBarraEscura">#3A5969</Color>
    <Color x:Key="CorAccent">#2563EB</Color>
    <Color x:Key="CorAccentEscuro">#1D4ED8</Color>
    <Color x:Key="CorSucesso">#16A34A</Color>
    <Color x:Key="CorPerigo">#DC2626</Color>
    <Color x:Key="CorFundoClaro">#F3F5F9</Color>
    <Color x:Key="CorBorda">#DFE4EC</Color>
    <Color x:Key="CorTextoPrimario">#1E293B</Color>
    <Color x:Key="CorTextoSecundario">#647084</Color>

    <SolidColorBrush x:Key="PincelBarraEscura" Color="{StaticResource CorBarraEscura}" />
    <SolidColorBrush x:Key="PincelAccent" Color="{StaticResource CorAccent}" />
    <SolidColorBrush x:Key="PincelAccentEscuro" Color="{StaticResource CorAccentEscuro}" />
    <SolidColorBrush x:Key="PincelSucesso" Color="{StaticResource CorSucesso}" />
    <SolidColorBrush x:Key="PincelPerigo" Color="{StaticResource CorPerigo}" />
    <SolidColorBrush x:Key="PincelFundoClaro" Color="{StaticResource CorFundoClaro}" />
    <SolidColorBrush x:Key="PincelBorda" Color="{StaticResource CorBorda}" />
    <SolidColorBrush x:Key="PincelTextoPrimario" Color="{StaticResource CorTextoPrimario}" />
    <SolidColorBrush x:Key="PincelTextoSecundario" Color="{StaticResource CorTextoSecundario}" />

</ResourceDictionary>
